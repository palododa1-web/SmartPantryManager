<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/textDetailName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Ingredients"
            android:textColor="#2E7D32" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/textDetailIngredients" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:lineSpacingExtra="4dp" android:textSize="16sp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Method"
            android:textColor="#2E7D32" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/textDetailSteps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:lineSpacingExtra="4dp" android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
